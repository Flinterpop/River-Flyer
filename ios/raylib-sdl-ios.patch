 // Update CORE input touch point info from SDL touch data
+#if defined(SDL_PLATFORM_IOS)
+// The GL view's framebuffer, which rlgl treats as the screen (see rlgl.h).
+unsigned int rlGetDefaultFramebuffer(void)
+{
+    if (platform.window == NULL) return 0;
+    return (unsigned int)SDL_GetNumberProperty(SDL_GetWindowProperties(platform.window), SDL_PROP_WINDOW_UIKIT_OPENGL_FRAMEBUFFER_NUMBER, 0);
+}
+
+static void UpdateWindowSizeSDL(void)
+{
+    int w = 0, h = 0, pw = 0, ph = 0;
+    SDL_GetWindowSize(platform.window, &w, &h);
+    SDL_GetWindowSizeInPixels(platform.window, &pw, &ph);
+    if ((w <= 0) || (h <= 0) || (pw <= 0) || (ph <= 0)) return;
+
+    CORE.Window.screen.width = w;
+    CORE.Window.screen.height = h;
+    CORE.Window.render.width = pw;
+    CORE.Window.render.height = ph;
+    CORE.Window.currentFbo.width = pw;
+    CORE.Window.currentFbo.height = ph;
+    CORE.Window.screenScale = MatrixScale((float)pw/(float)w, (float)ph/(float)h, 1.0f);
+}
+#endif
+
